{
  "name": "hab-creative-desktop",
  "version": "1.5.2",
  "description": "HAB CREATIVE Desktop Application",
  "main": "main.js",
  "author": {
    "name": "Bui Hai Trong",
    "email": "buihaitrong.dev@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/habcreative2026/hab-creative-portfolio.git"
  },
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win --x64 --publish never",
    "build:mac": "electron-builder --mac --x64 --arm64 --publish never",
    "build:mac:arm64": "electron-builder --mac --arm64 --publish never",
    "build:mac:x64": "electron-builder --mac --x64 --publish never",
    "build:linux": "electron-builder --linux --x64 --publish never",
    "build:linux:arm64": "electron-builder --linux --arm64 --publish never",
    "build:all": "electron-builder -wml --publish never",
    "build:all:arm64": "electron-builder -wml --arm64 --publish never",
    "clean": "rm -rf dist/",
    "postinstall": "electron-builder install-app-deps"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "@tensorflow/tfjs": "^1.7.4",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "face-api.js": "^0.22.2",
    "node-machine-id": "^1.1.12"
  },
  "build": {
    "appId": "com.habcreative.desktop",
    "productName": "HAB Creative",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "preload.js",
      "face-manager.html",
      "face-register.html",
      "face-register.js",
      "face-shared.js",
      "face-unlock.html",
      "face-unlock.js",
      "assets/**/*",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "models",
        "to": "models",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "node_modules/@tensorflow/tfjs/dist/tf.min.js",
        "to": "libs/tf.min.js"
      },
      {
        "from": "node_modules/face-api.js/dist/face-api.min.js",
        "to": "libs/face-api.min.js"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "perMachine": false,
      "allowElevation": true,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "extendInfo": {
        "NSCameraUsageDescription": "Ứng dụng cần quyền truy cập camera để nhận diện khuôn mặt Face ID.",
        "NSMicrophoneUsageDescription": "Ứng dụng cần quyền truy cập microphone.",
        "NSClipboardUsageDescription": "Ứng dụng cần quyền truy cập clipboard để hỗ trợ copy/paste.",
        "NSAppleEventsUsageDescription": "Ứng dụng cần quyền gửi Apple Events.",
        "LSApplicationCategoryType": "public.app-category.productivity",
        "NSHighResolutionCapable": true,
        "LSMinimumSystemVersion": "10.13.0"
      }
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "Utility",
      "maintainer": "Bui Hai Trong <buihaitrong.dev@gmail.com>",
      "desktop": {
        "Name": "HAB Creative",
        "Comment": "Portfolio Desktop App",
        "Categories": "Utility;Office;"
      }
    },
    "artifactName": "HAB-Creative-${version}-${os}-${arch}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "habcreative2026",
        "repo": "hab-creative-portfolio",
        "releaseType": "release"
      }
    ]
  }
}
